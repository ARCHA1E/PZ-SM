# --- PZSM settings (copy to .env) ---

# Web panel admin password (first boot). If empty, the panel asks you to create one.
PZSM_ADMIN_PASSWORD=

# Host port for the web panel
PZSM_PANEL_PORT=8080

# Where everything is stored on the host (game install, saves, configs, backups)
PZSM_DATA_DIR=./data

# Initial server settings (first boot only; change later in the panel)
PZ_SERVER_NAME=pzserver
PZ_BRANCH=public
PZ_MAX_MEMORY=8g

# Game ports (seeded into the ini on first start; if you change them later, also change
# DefaultPort / UDPPort in Server Settings).
PZ_GAME_PORT=16261
PZ_UDP_PORT=16262

# Install the game server automatically on first start (otherwise click "Install" in the panel)
PZSM_AUTO_INSTALL=1

# Run as this user/group on the host (match the owner of PZSM_DATA_DIR)
PUID=1000
PGID=1000
TZ=UTC

# Set to 1 when the panel is served behind an HTTPS reverse proxy
TRUST_PROXY=0
PZSM_SECURE_COOKIES=0
